# 사이트 기본 URL (canonical, sitemap, OG에 사용). 도메인 연결 전에는 Vercel 미리보기 URL을 넣어도 됨
NEXT_PUBLIC_SITE_URL=https://ev.io.kr

# 구글 애드센스 게시자 ID. 비워 두면 코드 기본값(ca-pub-9408914409364609)이 쓰인다.
# 로컬에서 광고 스크립트/ads.txt를 끄려면 off 로 설정
NEXT_PUBLIC_ADSENSE_CLIENT=
# 승인 후 광고 단위(슬롯) ID. 비어 있으면 해당 자리에 아무것도 렌더링하지 않음
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_REGION=
NEXT_PUBLIC_ADSENSE_SLOT_CAR=
NEXT_PUBLIC_ADSENSE_SLOT_CALC=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# 검색엔진 소유 확인 (선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 1로 설정하면 ev.or.kr 실시간 수집을 건너뛰고 스냅샷만 사용 (로컬 개발·빌드 속도용)
EV_DISABLE_LIVE_FETCH=
